# Site Configuration
NEXT_PUBLIC_SITE_URL=https://meelte.com

# Supabase
# Server-only meelTe Web API v1 base. Use the dev RPC base for local work and
# previews; configure the production RPC base only in the live deployment.
MEELTE_SUPABASE_ANON_KEY=
MEELTE_API_BASE=

# HR Portal Authentication (Server-Only — Never expose in client code)
# Generate secure hash with: node scripts/generate-hr-hash.mjs "<password>"
HR_EMAIL=
HR_PASSWORD_HASH=
HR_SESSION_SECRET=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

#firebase
NEXT_PUBLIC_FIREBASE_CONFIG=